package com.netsimon.leve.config

import org.json.JSONArray
import org.json.JSONObject

/**
 * Perfis de servidor (operadoras/rotas) do app.
 *
 * Config em JSON de texto cru (constante PROFILES_JSON abaixo), editável
 * direto no Android Studio — sem Base64 por enquanto, pra facilitar os testes.
 * Lembre que texto cru aparece de bandeja em ferramentas tipo MT Manager/apktool;
 * quando a config estabilizar dá pra voltar a ofuscar (Base64 fragmentado).
 * Senhas de usuário final continuam vindas do painel via CheckUser, nunca daqui.
 */
enum class ServerMode {
    VLESS_XHTTP, SSH_DIRECT, SSL_PROXY, SLOWDNS, SSH_BHTTP
}

data class ServerProfile(
    val name: String,
    val description: String,
    val mode: ServerMode,
    val category: String,
    val active: Boolean,
    val visible: Boolean,
    val server: String,          // pode conter múltiplos hosts separados por '#' (rotate)
    val port: Int,
    // --- VLESS_XHTTP ---
    val uuid: String? = null,    // fixo REMOVIDO em modo de teste (opcao A) -- ver uuidOverride em XhttpManager
    val xhttpMode: String? = null,
    val pcs: String? = null,
    val security: String? = null,
    val alpn: String? = null,
    val encryption: String? = null,
    val hostHeader: String? = null,
    val fp: String? = null,
    val allowInsecure: Boolean = false,
    // --- SSH_DIRECT / SSL_PROXY ---
    val payload: String? = null,
    val proxyHost: String? = null,
    val proxyPort: Int? = null,
    // --- SLOWDNS (reservado) ---
    val nameserver: String? = null,
    val publicKey: String? = null,
    // --- SSH_BHTTP ---
    // Transporte BHTTP: janelas paralelas de upload (1..16) e download
    // (1..32); batch fixo de 8. Os defaults abaixo são os mesmos do perfil
    // BHTTP que funciona em outro app; o chunk de download é só o PEDIDO —
    // a calibração automática cai pro que o servidor aceitar.
    val bhttpUploadSlots: Int = 16,
    val bhttpDownloadSlots: Int = 32,
    val bhttpDownloadChunk: Int = 50000,
    val bhttpConnectMs: Int = 10000,
    val bhttpReadMs: Int = 25000,
    val bhttpProbeMs: Int = 5000,
    val bhttpMaxAttempts: Int = 10,
    val bhttpRetryBackoffMs: Int = 150,
    // --- comuns ---
    val sni: String? = null,
    val dns1: String? = null,
    val dns2: String? = null,
    val urlCheckUser: String? = null
)

