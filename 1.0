package com.netsimon.leve.config

import android.content.Context
import android.util.Base64
import org.json.JSONArray
import org.json.JSONObject
import java.io.File

enum class ServerMode {
    VLESS_XHTTP, SSH_DIRECT, SSL_PROXY, SLOWDNS, SSH_BHTTP
}

data class ServerProfile(
    val name: String,
    val description: String,
    val mode: ServerMode,
    val category: String,
    val active: Boolean,
    val visible: Boolean,
    val server: String,
    val port: Int,
    val uuid: String? = null,
    val xhttpMode: String? = null,
    val pcs: String? = null,
    val security: String? = null,
    val alpn: String? = null,
    val encryption: String? = null,
    val hostHeader: String? = null,
    val fp: String? = null,
    val allowInsecure: Boolean = false,
    val payload: String? = null,
    val proxyHost: String? = null,
    val proxyPort: Int? = null,
    val nameserver: String? = null,
    val publicKey: String? = null,
    val bhttpUploadSlots: Int = 16,
    val bhttpDownloadSlots: Int = 32,
    val bhttpDownloadChunk: Int = 50000,
    val bhttpConnectMs: Int = 10000,
    val bhttpReadMs: Int = 25000,
    val bhttpProbeMs: Int = 5000,
    val bhttpMaxAttempts: Int = 10,
    val bhttpRetryBackoffMs: Int = 150,
    val sni: String? = null,
    val dns1: String? = null,
    val dns2: String? = null,
    val urlCheckUser: String? = null
)

object ServerProfiles {

    // JSON dos perfis embutido em Base64 (UTF-8), em fragmentos de até 2048 caracteres.
    // Gerado a partir do JSON original; para atualizar, substitua o conteúdo de listOf(...).
    private val PROFILES_PARTS = listOf(
        "",
        "",
        "",
        "",
        "",
        "",
        ""
    )

    private val PROFILES_JSON: String by lazy {
        String(Base64.decode(PROFILES_PARTS.joinToString(""), Base64.DEFAULT), Charsets.UTF_8)
    }

    private const val REMOTE_FILE = "profiles_remote.json"

    /** Resultado de [applyRemote]. */
    sealed class ApplyResult {
        data class Updated(val version: String, val profileCount: Int) : ApplyResult()
        data class UpToDate(val localVersion: String, val remoteVersion: String) : ApplyResult()
        data class Invalid(val reason: String) : ApplyResult()
    }

    private class ParsedConfig(val version: String, val profiles: List<ServerProfile>)

    private val lock = Any()

    @Volatile private var initialized = false
    @Volatile private var storageDir: File? = null
    @Volatile private var current: ParsedConfig? = null

    /** Config embutida no app (fallback). */
    private val embedded: ParsedConfig by lazy { parseConfig(PROFILES_JSON) }

    /**
     * Carrega a config salva da última atualização online (se existir e for
     * mais nova que a embutida). Pode ser chamado várias vezes.
     */
    fun init(context: Context) {
        if (initialized) return
        synchronized(lock) {
            if (initialized) return
            val dir = context.applicationContext.filesDir
            storageDir = dir
            var loaded: ParsedConfig = embedded
            try {
                val f = File(dir, REMOTE_FILE)
                if (f.isFile) {
                    val saved = parseConfig(f.readText(Charsets.UTF_8))
                    if (compareVersions(saved.version, embedded.version) > 0) loaded = saved
                }
            } catch (_: Exception) {
                // arquivo salvo corrompido: segue com a config embutida
            }
            current = loaded
            initialized = true
        }
    }

    /** Versão da config em uso (salva ou embutida). */
    fun currentVersion(): String = (current ?: embedded).version

    /**
     * Valida e aplica a config remota (mesmo formato do JSON embutido).
     * Só aplica se a "version" remota for maior que a atual.
     */
    fun applyRemote(text: String): ApplyResult {
        val remote: ParsedConfig = try {
            parseConfig(text)
        } catch (e: Exception) {
            return ApplyResult.Invalid("JSON inválido: ${e.message}")
        }

        return synchronized<ApplyResult>(lock) {
            val local = current ?: embedded
            if (compareVersions(remote.version, local.version) <= 0) {
                return@synchronized ApplyResult.UpToDate(local.version, remote.version)
            }
            try {
                persist(text)
            } catch (e: Exception) {
                return@synchronized ApplyResult.Invalid("falha ao salvar config: ${e.message}")
            }
            current = remote
            ApplyResult.Updated(remote.version, remote.profiles.size)
        }
    }

    private fun persist(text: String) {
        val dir = storageDir ?: return // sem init(): aplica só em memória
        val target = File(dir, REMOTE_FILE)
        val tmp = File(dir, "$REMOTE_FILE.tmp")
        tmp.writeText(text, Charsets.UTF_8)
        if (!tmp.renameTo(target)) {
            target.delete()
            if (!tmp.renameTo(target)) {
                tmp.delete()
                throw java.io.IOException("não foi possível gravar $REMOTE_FILE")
            }
        }
    }

    /** Compara versões "1.0", "1.2.3" etc. Retorna >0 se a > b. */
    private fun compareVersions(a: String, b: String): Int {
        val pa = a.trim().split('.').map { it.trim().toIntOrNull() ?: 0 }
        val pb = b.trim().split('.').map { it.trim().toIntOrNull() ?: 0 }
        for (i in 0 until maxOf(pa.size, pb.size)) {
            val x = pa.getOrElse(i) { 0 }
            val y = pb.getOrElse(i) { 0 }
            if (x != y) return x.compareTo(y)
        }
        return 0
    }

    private fun parseConfig(json: String): ParsedConfig {
        val trimmed = json.trim()
        val root: JSONObject =
            if (trimmed.startsWith("[")) JSONArray(trimmed).getJSONObject(0) else JSONObject(trimmed)

        val version = root.optString("version", "").trim()
        if (version.isEmpty()) throw IllegalArgumentException("campo 'version' ausente")

        val arr = root.optJSONArray("profiles")
            ?: throw IllegalArgumentException("campo 'profiles' ausente")
        if (arr.length() == 0) throw IllegalArgumentException("lista 'profiles' vazia")

        val result = mutableListOf<ServerProfile>()
        for (i in 0 until arr.length()) {
            result.add(parseProfile(arr.getJSONObject(i)))
        }
        return ParsedConfig(version, result)
    }

    private fun parseProfile(o: JSONObject): ServerProfile {
        return ServerProfile(
            name = o.getString("name"),
            description = o.optString("description", ""),
            mode = ServerMode.valueOf(o.getString("mode")),
            category = o.optString("category", ""),
            active = o.optBoolean("active", true),
            visible = o.optBoolean("visible", true),
            server = o.getString("server"),
            port = o.getInt("port"),
            uuid = o.optStringOrNull("uuid"),
            xhttpMode = o.optStringOrNull("xhttpMode"),
            pcs = o.optStringOrNull("pcs"),
            security = o.optStringOrNull("security"),
            alpn = o.optStringOrNull("alpn"),
            encryption = o.optStringOrNull("encryption"),
            hostHeader = o.optStringOrNull("hostHeader"),
            fp = o.optStringOrNull("fp"),
            allowInsecure = o.optBoolean("allowInsecure", false),
            payload = o.optStringOrNull("payload"),
            proxyHost = o.optStringOrNull("proxyHost"),
            proxyPort = if (o.has("proxyPort") && !o.isNull("proxyPort")) o.getInt("proxyPort") else null,
            nameserver = o.optStringOrNull("nameserver"),
            publicKey = o.optStringOrNull("publicKey"),
            bhttpUploadSlots = o.optInt("bhttpUploadSlots", 16),
            bhttpDownloadSlots = o.optInt("bhttpDownloadSlots", 32),
            bhttpDownloadChunk = o.optInt("bhttpDownloadChunk", 50000),
            bhttpConnectMs = o.optInt("bhttpConnectMs", 10000),
            bhttpReadMs = o.optInt("bhttpReadMs", 25000),
            bhttpProbeMs = o.optInt("bhttpProbeMs", 5000),
            bhttpMaxAttempts = o.optInt("bhttpMaxAttempts", 10),
            bhttpRetryBackoffMs = o.optInt("bhttpRetryBackoffMs", 150),
            sni = o.optStringOrNull("sni"),
            dns1 = o.optStringOrNull("dns1"),
            dns2 = o.optStringOrNull("dns2"),
            urlCheckUser = o.optStringOrNull("urlCheckUser")
        )
    }

    fun getAllProfiles(): List<ServerProfile> = (current ?: embedded).profiles

    fun getMenuProfiles(): List<ServerProfile> {
        return getAllProfiles().filter { profile: ServerProfile -> profile.visible && profile.active }
    }

    @Suppress("unused")
    fun getProfilesInGroup(categoryGroup: String): List<ServerProfile> {
        return getMenuProfiles().filter { profile: ServerProfile -> profile.category == categoryGroup }
    }

    private fun JSONObject.optStringOrNull(key: String): String? =
        if (has(key) && !isNull(key)) getString(key) else null
}
